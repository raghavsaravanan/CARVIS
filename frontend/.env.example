# Carvis API. The Vite dev proxy uses /api by default.
VITE_CARVIS_API_URL=/api

# SpacetimeDB Cloud connection (defaults to maincloud + hackutd)
VITE_SPACETIMEDB_URI=https://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB_NAME=hackutd
# Optional SpacetimeAuth OIDC Client ID if using OIDC redirect flow
# VITE_SPACETIMEAUTH_CLIENT_ID=
