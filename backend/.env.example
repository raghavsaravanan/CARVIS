LLAMA_CLOUD_API_KEY=
VAPI_WEBHOOK_SECRET=
QDRANT_URL=
QDRANT_API_KEY=

# Staging writes only. Use a new generation after the collection has an alias.
CARVIS_INGEST_COLLECTION=carvis_specs_v2
# Set only after source review and migration validation/activation:
# CARVIS_QDRANT_COLLECTION=carvis_specs_active
# Until configured, requests refuse with migration_pending against the legacy collection.
CARVIS_PARSER_VERSION=latest
# Pin a supported LlamaParse release for repeatable production extraction.
NEMOTRON_MAX_TOKENS=2048

# Vision identification. This key is server-only; never expose it in Vite.
VISION_PROVIDER=nemotron
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional development fallback. Leave unset when using Nemotron.
# OPENAI_API_KEY=
# VISION_MODEL=gpt-5.5

# Optional SpacetimeDB event logging for shop calls.
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DB_NAME=hackutd
SPACETIMEDB_TOKEN=

# Runtime. Render supplies PORT in production.
# RENDER=
# PORT=8000
